{
  "expo": {
    "name": "Crezo",
    "slug": "crezo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "crezo",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crezo.crezoApp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131313"
      },
      "package": "com.crezo.crezoApp"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1d691ae0-5d08-4135-a8ac-0fa3292ccee3"
      }
    },
    "owner": "jnvtarun"
  }
}
