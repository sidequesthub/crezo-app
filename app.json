{
  "expo": {
    "name": "Crezo",
    "slug": "crezo-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "crezo",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crezo.crezoApp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "19",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0C0E"
      },
      "package": "com.crezo.crezoApp",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "photosPermission": "Crezo shows your camera roll so you can organise clips into folders. Your media stays on your device — Crezo never uploads or moves it.",
          "savePhotosPermission": "Crezo needs this only if you choose to export a folder as an album in your Photos app.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-image",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#131313",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "./plugins/withoutPushEntitlement",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.54775582157-rskti2i43p73f21ncojpol86kdsdp2uj"
        }
      ],
      "expo-apple-authentication"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1d691ae0-5d08-4135-a8ac-0fa3292ccee3"
      }
    },
    "owner": "jnvtarun",
    "icon": "./assets/images/icon.png",
    "updates": {
      "url": "https://u.expo.dev/1d691ae0-5d08-4135-a8ac-0fa3292ccee3",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
